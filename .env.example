# Copy to .env (or .env.local) and fill in real values. Never commit real secrets.
# NEXT_PUBLIC_* variables are inlined into the browser bundle — never put secrets in them.

# --- Supabase ---
# Project URL; used by lib/supabase/client.ts, lib/supabase/server.ts, middleware.ts, api/stripe-webhook, api/prayer/refresh
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key for browser/server/middleware auth clients (lib/supabase/client.ts, lib/supabase/server.ts, middleware.ts) and the fund check in api/checkout
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SECRET, server-only; bypasses RLS for writes in api/stripe-webhook and api/prayer/refresh (incl. prayer overrides)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ---
# Public base URL, no trailing slash; Stripe success/cancel URLs (api/checkout) and unsubscribe links in emails (api/send, api/send/bulk)
NEXT_PUBLIC_SITE_URL=https://your-site-url-here

# --- Stripe ---
# SECRET; creates Checkout sessions (api/checkout) and verifies events (api/stripe-webhook)
STRIPE_SECRET_KEY=sk_test_your-key-here
# SECRET; signing secret used to verify incoming webhook signatures (api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# --- Resend ---
# SECRET; sends announcement emails (api/send, api/send/bulk)
RESEND_API_KEY=re_your-key-here

# --- Prayer API ---
# Upstream prayer-times endpoint fetched daily by api/prayer/refresh
PRAYER_API_URL=https://your-prayer-api-url-here
# "true" = the refresh stores ~30 days per run from pape-api's /prayer-times/range
# (needs pape-admin migrations M1-M4). Anything else = today's row only, as before.
# ?dry=1 on the refresh route runs the 30-day path without writing, regardless of this.
PRAYER_RANGE_ENABLED=false
# Where the 30-day refresh sends operational alerts (today's row missing, under 7 days
# stored, Monthly failed, call cap reached). Sent with RESEND_API_KEY.
ALERT_EMAIL=you@example.com

# --- Cron ---
# SECRET; api/prayer/refresh requires it as "Authorization: Bearer <secret>" (Vercel Cron sends this) or "x-cron-secret" header
CRON_SECRET=your-random-secret-here
